<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="PRATA Remote Agent"
        android:theme="@style/Theme.PratarAgent"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".service.AgentForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProjection|camera" />
        <!-- AccessibilityService untuk eksekusi sentuhan remote (Command 005).
             Android TIDAK mengizinkan aktivasi programatik — user harus
             mengaktifkannya manual di Pengaturan > Aksesibilitas. -->
        <service
            android:name=".service.PrataAccessibilityService"
            android:exported="false"
            android:label="PRATA Remote — Kontrol Jarak Jauh"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
        <!-- NotificationListenerService — meneruskan notifikasi perangkat ke
             Controller lewat WebSocket. Izin diaktifkan manual di Pengaturan. -->
        <service
            android:name=".service.PrataNotificationListenerService"
            android:exported="false"
            android:label="PRATA Remote — Notifikasi"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
