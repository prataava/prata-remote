# PRATA Remote — Backend .env.example
# Salin ke .env dan isi. JANGAN commit .env berisi secret.
#
# --- Server ---
PORT=8080
HOST=0.0.0.0

# --- Auth controller (JWT HS256) ---
# WAJIB di produksi. Hasilkan dengan:  openssl rand -hex 32
JWT_SECRET=isi-dengan-secret-acak-minimal-32-karakter

# --- Token login (detik; default 8 jam) ---
LOGIN_TOKEN_TTL_SEC=28800

# --- Mode pengembangan (JANGAN=1 di produksi) ---
# Bila JWT_SECRET kosong dan PRATA_DEV=1, server memakai secret dev.
PRATA_DEV=0

# --- Store: memory | disk | prisma — satu per domain ---
# Default: disk (persisten file JSON di data/prata-store.json) bila
# DATABASE_URL kosong; prisma bila DATABASE_URL diset. Env eksplisit
# selalu menang. "disk" = default baru sejak FINALISASI Langkah 1.
USER_STORE=disk
PAIRING_STORE=disk
DEVICE_STORE=disk
SESSION_STORE=disk
TRANSFER_STORE=disk
DEVICE_KEY_STORE=disk
PERMISSION_STORE=disk
ACTIVITY_LOG_STORE=disk
AUTOMATION_RULE_STORE=disk
NOTIFICATION_STORE=disk

# --- Disk store (FINALISASI Langkah 1) ---
# PRATA_DATA_FILE=./data/prata-store.json
# PRATA_BLOB_DIR=./data/blobs
# BLOB_STORE=disk
# PRATA_WEB_DIR=../../web
# PRATA_RELEASES_DIR=./public/releases
# PRATA_SOURCE_BUNDLE=./public/releases/prata-remote-full-release.tar.gz

# --- Transfer file (Command 008): batas ukuran blob 50 MB, TTL 10 menit.
# Blob byte TIDAK PERNAH masuk database — hanya metadata (tabel
# file_transfers). Blob disimpan di DISK (data/blobs/<transferId>.bin)
# dengan streaming + cleanup berkala tiap 60 detik.

# --- Database (wajib bila ada store prisma) ---
DATABASE_URL=postgresql://prata:prata@localhost:5432/prata_remote?schema=public

# --- Seed dev (hanya bila PRATA_DEV=1) ---
# User pertama: "email:password[:nama]"
PRATA_SEED_USER=owner@prata.test:KataSandiKuat123:Pemilik
# Perangkat dev: "deviceId:token,deviceId:token" (token mentah; yang
# disimpan di store hanya SHA-256-nya).
PRATA_AGENT_TOKENS=device-1:token-rahasia-1
# Pemilik perangkat dev: "deviceId:userId"
PRATA_AGENT_OWNERS=device-1:user-1

# --- Kehadiran (milidetik) ---
HEARTBEAT_TIMEOUT_MS=45000
PRESENCE_SWEEP_MS=10000

# --- TURN (Phase 2 — belum dipakai) ---
# TURN_URLS=turn:turn.prata.local:3478
# TURN_USERNAME=prata
# TURN_CREDENTIAL=isi-secret-turn
# Bila TURN_* diisi ketiganya, server menambahkannya ke konfigurasi ICE
# (STUN Google selalu ada sebagai fallback). Tanpa TURN, WebRTC tetap
# jalan antar peer yang bisa terhubung langsung / via STUN.
